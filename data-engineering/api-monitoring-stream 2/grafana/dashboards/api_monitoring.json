{
 "title": "API monitoring",
 "uid": "api-monitoring",
 "schemaVersion": 39,
 "refresh": "10s",
 "time": {
  "from": "now-30m",
  "to": "now"
 },
 "panels": [
  {
   "type": "timeseries",
   "title": "p95 latency by service",
   "datasource": {
    "type": "grafana-postgresql-datasource",
    "uid": "monitoring"
   },
   "gridPos": {
    "h": 9,
    "w": 12,
    "x": 0,
    "y": 0
   },
   "fieldConfig": {
    "defaults": {
     "unit": "ms"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "monitoring"
     },
     "format": "time_series",
     "rawQuery": true,
     "editorMode": "code",
     "rawSql": "SELECT window_start AS time, service AS metric, p95_latency_ms AS value FROM service_windows WHERE $__timeFilter(window_start) ORDER BY 1"
    }
   ]
  },
  {
