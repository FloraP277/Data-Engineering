  {
   "type": "table",
   "title": "Alerts",
   "datasource": {
    "type": "grafana-postgresql-datasource",
    "uid": "monitoring"
   },
   "gridPos": {
    "h": 9,
    "w": 12,
    "x": 12,
    "y": 9
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "monitoring"
     },
     "format": "table",
     "rawQuery": true,
     "editorMode": "code",
     "rawSql": "SELECT window_start, service, rule, round(value::numeric, 3) AS value, round(threshold::numeric, 3) AS threshold FROM alerts WHERE $__timeFilter(window_start) ORDER BY window_start DESC LIMIT 100"
    }
   ]
  }
 ]
